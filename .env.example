# ─── App ───────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
LOG_FORMAT=pretty
CORS_ORIGIN=http://localhost:3000

# ─── Database ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=water_credits
# Enable TLS for managed Postgres (AWS RDS, GCP Cloud SQL, etc.)
DATABASE_SSL=false
# Path to a PEM CA bundle for verifying the server cert (optional)
DATABASE_SSL_CA=
# Set to false for self-signed certs in staging
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ─── JWT ──────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=7d
JWT_REFRESH_EXPIRATION=30d

# ─── Stellar ──────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_BACKEND_SECRET=
# Fail boot if STELLAR_BACKEND_SECRET is missing/placeholder/invalid.
# Set to true in production so a misconfigured key cannot look healthy.
STELLAR_REQUIRE_SIGNING_KEY=false
# Optional secret for the never-funded simulation account. Leave empty to use a deterministic testnet-only fallback.
STELLAR_SIMULATION_SECRET=
STELLAR_BACKEND_PUBLIC=

# ─── Oracle ───────────────────────────────────────
ORACLE_CONTRACT_ID=
ORACLE_TRUSTED_SIGNERS=
# Address the SCHEDULED submission cycle submits as. Leave empty to disable
# scheduled submissions (manual POST /oracle/trigger carries its own address).
ORACLE_ADDRESS=
ORACLE_SECRET=

# ─── Oracle scheduler ─────────────────────────────
# Cron expression for the automatic oracle submission cycle.
# Default 0 * * * * (hourly, on the hour). 5- or 6-field (leading seconds)
# expressions are accepted; testnet operators can run more frequently, e.g.
# */5 * * * * for every five minutes. A malformed value falls back to hourly.
ORACLE_SUBMISSION_INTERVAL_CRON=0 * * * *
# Set to false to keep the cron registered but inert (local dev, or replicas
# that must not submit). Any other value leaves it enabled.
ORACLE_SCHEDULER_ENABLED=true
# Seconds without a completed cycle before GET /health reports the oracle as
# degraded. Default 7200 (two hourly cycles).
ORACLE_STALENESS_THRESHOLD_S=7200

# ─── Sensor ───────────────────────────────────────
# Maximum age of a sensor reading (seconds) before rejection.
# Default: 86400 (24 hours). Prevents acceptance of readings from stalled devices.
SENSOR_MAX_AGE_SECONDS=86400
# Maximum future offset for sensor readings (seconds) to allow for clock skew.
# Default: 300 (5 minutes). Allows for minor clock differences between sensor and server.
SENSOR_FUTURE_OFFSET_SECONDS=300

# ─── Allowlist ────────────────────────────────────
# Contract ID for the asset allowlist (C… StrKey format).
# Used by src/scripts/allowlist-add.ts and allowlist-revoke.ts.
CONTRACT_ALLOWLIST_ID=

# ─── Redis / Queue ────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_CONCURRENCY_SENSOR_INGESTION=5
QUEUE_CONCURRENCY_ORACLE_SUBMIT=1
QUEUE_CONCURRENCY_RETIREMENTS=2

# ─── WebSocket ────────────────────────────────────
WS_PORT=3002
WS_PATH=/ws
